POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=chickenfaight
POSTGRES_URL="postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"
# Separate database for `uv run pytest`; integration tests are skipped without it.
TEST_POSTGRES_URL="postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/chickenfaight_test"

# Create an OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=example-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Generate locally with: openssl rand -hex 32
SESSION_SECRET=random-hex
# Signs BILC access tokens. Generate the same way, and keep it different from SESSION_SECRET.
BILC_JWT_SECRET=random-hex
# Optional: BILC versions below this are refused and told to update (default 0.1.0).
# Unversioned development builds ("dev") are accepted only when APP_ENV=development.
# BILC_MIN_SUPPORTED_VERSION=0.1.0

FRONTEND_URL=http://localhost:3000
SECURE_COOKIES=false

# "development" lets server startup wipe and rebuild a local database that
# migrations can't repair (see BACKEND.md). Never set this in production.
APP_ENV=development

# Any OpenAI-compatible provider. OpenRouter (free tier: 50 requests/day across all free models):
INFERENCE_BASE_URL=https://openrouter.ai/api/v1
INFERENCE_API_KEY=sk-or-example
# Arguments use the lobby-selected database model. Don't use openrouter/free.
# Optional judge; defaults to nvidia/nemotron-3-super-120b-a12b:free.
# INFERENCE_JUDGE_MODEL=
#
# Purdue GenAI Studio instead (key: genai.rcac.purdue.edu, Settings > Account > API Keys):
# INFERENCE_BASE_URL=https://genai.rcac.purdue.edu/api
# INFERENCE_API_KEY=sk-example
# mistral:latest is the only model tested that serves requests in parallel (12 turns at once
# finished in about 13 s); llama3.3:70b and others queue requests one at a time. The key also
# has a per-minute rate limit, which returns HTTP 400 "Rate limit exceeded".
# For argument generation, select a database model whose api_model_id is mistral:latest.
# INFERENCE_JUDGE_MODEL=mistral:latest
